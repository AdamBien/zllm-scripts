#!/usr/bin/env -S java --source 25

interface Boundary {

    String NAME = MethodHandles.lookup().lookupClass().getEnclosingClass().getName();
    String VERSION = "2026-10-10.1";

    static void outline(List<String> args) {
        Trace.invocation(NAME, VERSION, args);
        Log.USER.out("%s %s root=%s".formatted(NAME, VERSION, Control.root()));
        try {
            var query = parse(args);
            var scope = new Entity.Scope(Control.root(), false);
            var files = Control.starts(scope, query.paths());
            var directory = files.stream().filter(Files::isDirectory).findFirst();
            if (directory.isPresent())
                throw new IllegalArgumentException("is a directory, list it with files '*.md': " + scope.relative(directory.get()));
            var found = Control.outline(scope, files, query, Log.USER::out, Log.NOTE::out);
            Log.exit(found > 0 ? Exit.FOUND : Exit.NOTHING);
        } catch (SecurityException e) {
            Log.stop(e.getMessage(), Exit.DENIED);
        } catch (IllegalArgumentException | IOException e) {
            Log.stop(e.getMessage(), Exit.USAGE);
        }
    }

    static Entity.Query parse(List<String> args) {
        var paths = new ArrayList<String>();
        var depth = 6;
        var list = false;
        var max = 500;
        var tokens = Arg.expand(args);
        for (int i = 0; i < tokens.size(); i++) {
            var token = tokens.get(i);
            if (token.equals("--")) {
                paths.addAll(tokens.subList(i + 1, tokens.size()));
                break;
            }
            switch (Arg.from(token)) {
                case HELP -> usage();
                case SHOW_VERSION -> Log.exit(Exit.FOUND);
                case DEPTH -> depth = Arg.number(tokens, ++i, token);
                case LIST -> list = true;
                case MAX -> max = Arg.number(tokens, ++i, token);
                case null -> {
                    if (token.startsWith("-") && token.length() > 1)
                        throw new IllegalArgumentException("unknown option: " + token + " (put -- before a file starting with -)");
                    paths.add(token);
                }
            }
        }
        if (paths.isEmpty())
            usage();
        if (depth < 1 || depth > 6)
            throw new IllegalArgumentException("-depth expects 1 to 6, got: " + depth);
        return new Entity.Query(List.copyOf(paths), depth, list, max);
    }

    static void usage() {
        Log.USER.out("""
                Usage: %s <file...> [options]
                Read-only Markdown outline confined to the root
                (nearest directory containing .git, at or above the current directory, otherwise the current directory).
                Output: path:line:title for every heading (# marks kept), and with -list for every list item
                whose text starts with a bold span or a link (marker kept, title only). Fenced code is skipped.
                Lines over %d characters are cut with a …[+N chars] note. Truncation notes go to stderr.

                Options:
                %s
                  --                 end of options, use before a file starting with -

                Never read: .git, secrets (.env, *.pem, *.key, .npmrc, id_rsa, ...), paths outside the root,
                binary files. Files inside ignored directories (node_modules, dist, ...) are read when named.
                Exit: 0 entries found, 1 no entries, 2 usage error, 3 denied path.
                """.formatted(NAME, Control.MAX_WIDTH, Arg.usage()));
        Log.exit(Exit.FOUND);
    }

    enum Arg {
        HELP("-help", "", "show this help"),
        SHOW_VERSION("-version", "", "show version"),
        DEPTH("-depth", "<n>", "headings up to level n, 1 to 6 (default 6)"),
        LIST("-list", "", "include list items with a bold or linked title"),
        MAX("-max", "<n>", "stop after n entries across all files (default 500)");

        final String option;
        final String parameter;
        final String description;

        Arg(String option, String parameter, String description) {
            this.option = option;
            this.parameter = parameter;
            this.description = description;
        }

        boolean matches(String value) {
            return option.equals(value) || value.startsWith(option + ":");
        }

        static Arg from(String value) {
            return Stream.of(values())
                    .filter(arg -> arg.matches(value))
                    .findFirst()
                    .orElse(null);
        }

        static List<String> expand(List<String> args) {
            var tokens = new ArrayList<String>();
            for (int i = 0; i < args.size(); i++) {
                var arg = args.get(i);
                if (arg.equals("--")) {
                    tokens.addAll(args.subList(i, args.size()));
                    break;
                }
                var known = from(arg);
                if (known != null && arg.length() > known.option.length()) {
                    tokens.add(known.option);
                    tokens.add(arg.substring(known.option.length() + 1));
                } else {
                    tokens.add(arg);
                }
            }
            return tokens;
        }

        static String value(List<String> tokens, int index, String option) {
            if (index >= tokens.size())
                throw new IllegalArgumentException("missing value for " + option);
            return tokens.get(index);
        }

        static int number(List<String> tokens, int index, String option) {
            var value = value(tokens, index, option);
            if (!value.matches("\\d+"))
                throw new IllegalArgumentException(option + " expects a non-negative number, got: " + value);
            return Integer.parseInt(value);
        }

        static String usage() {
            return Stream.of(values())
                    .map(arg -> "  %-18s %s".formatted(arg.option + " " + arg.parameter, arg.description))
                    .collect(Collectors.joining("\n"));
        }
    }

    enum Exit {
        FOUND(0), NOTHING(1), USAGE(2), DENIED(3);

        final int code;

        Exit(int code) {
            this.code = code;
        }
    }

    enum Log {
        USER, NOTE, ERROR;

        void out(String message) {
            switch (this) {
                case USER -> IO.println(message);
                case NOTE -> System.err.println(message);
                case ERROR -> System.err.println(NAME + ": " + message);
            }
        }

        static void stop(String message, Exit exit) {
            ERROR.out(message);
            exit(exit);
        }

        static void exit(Exit exit) {
            Trace.exit(exit.code);
        }
    }
}

interface Control {

    int MAX_WIDTH = 2000;
    int HEAD = 8192;

    static int outline(Entity.Scope scope, List<Path> files, Entity.Query query, Consumer<String> out, Consumer<String> note) throws IOException {
        var budget = query.max();
        var found = 0;
        for (int index = 0; index < files.size(); index++) {
            var file = files.get(index);
            var path = scope.relative(file);
            if (budget == 0) {
                var rest = files.subList(index, files.size()).stream().map(scope::relative).collect(Collectors.joining(" "));
                note.accept("stopped at -max %d; not read: %s".formatted(query.max(), rest));
                break;
            }
            if (binary(file)) {
                note.accept(path + ": binary, not read");
                continue;
            }
            var entries = entries(file, query);
            var printed = entries.subList(0, Math.min(entries.size(), budget));
            printed.forEach(entry -> out.accept("%s:%d:%s".formatted(path, entry.line(), cut(entry.title()))));
            budget -= printed.size();
            found += printed.size();
            if (printed.size() < entries.size())
                note.accept("%s: stopped at -max %d after line %d; %d more entries, lower -depth or raise -max"
                        .formatted(path, query.max(), printed.getLast().line(), entries.size() - printed.size()));
        }
        return found;
    }

    static List<Entity.Entry> entries(Path file, Entity.Query query) throws IOException {
        var entries = new ArrayList<Entity.Entry>();
        var fence = Entity.Fence.NONE;
        var number = 0;
        try (var reader = new BufferedReader(new InputStreamReader(Files.newInputStream(file), StandardCharsets.UTF_8))) {
            for (var line = reader.readLine(); line != null; line = reader.readLine()) {
                number++;
                fence = fence.next(line);
                if (fence != Entity.Fence.NONE || fence.closed(line))
                    continue;
                Entity.Entry.parse(number, line, query).ifPresent(entries::add);
            }
        }
        return List.copyOf(entries);
    }

    static String cut(String line) {
        if (line.length() <= MAX_WIDTH)
            return line;
        return line.substring(0, MAX_WIDTH) + "…[+" + (line.length() - MAX_WIDTH) + " chars]";
    }

    static boolean binary(Path file) throws IOException {
        try (var stream = Files.newInputStream(file)) {
            return Entity.Scope.binary(stream.readNBytes(HEAD));
        }
    }

    // root and starts are shared verbatim by files, search and show — change them together

    static Path root() {
        try {
            var cwd = Path.of("").toRealPath();
            for (var dir = cwd; dir != null; dir = dir.getParent())
                if (Files.exists(dir.resolve(".git")))
                    return dir;
            return cwd;
        } catch (IOException e) {
            throw new UncheckedIOException(e);
        }
    }

    static List<Path> starts(Entity.Scope scope, List<String> paths) throws IOException {
        if (paths.isEmpty())
            return List.of(Path.of("").toRealPath());
        var starts = new ArrayList<Path>();
        for (var path : paths) {
            var candidate = Path.of(path).toAbsolutePath().normalize();
            if (!Files.exists(candidate))
                throw new IllegalArgumentException("not found: " + path);
            var real = candidate.toRealPath();
            if (!real.startsWith(scope.root()))
                throw new SecurityException("outside the root " + scope.root() + ": " + path);
            if (Files.isRegularFile(real) && scope.denied(real))
                throw new SecurityException("denied (may contain secrets): " + path);
            starts.add(real);
        }
        return starts;
    }
}

interface Entity {

    record Query(List<String> paths, int depth, boolean list, int max) {}

    record Entry(int line, String title) {

        static final Pattern HEADING = Pattern.compile("^ {0,3}(#{1,6})[ \\t]+(.+?)(?:[ \\t]+#+)?[ \\t]*$");
        static final Pattern ITEM = Pattern.compile("^ {0,3}(\\d{1,9}[.)]|[-*+])[ \\t]+(.*)$");
        static final Pattern BOLD = Pattern.compile("^(?:\\*\\*(.+?)\\*\\*|__(.+?)__)");
        static final Pattern LINK = Pattern.compile("^\\[([^\\]]+)\\]\\(");

        static Optional<Entry> parse(int number, String line, Query query) {
            var heading = HEADING.matcher(line);
            if (heading.matches()) {
                var level = heading.group(1).length();
                return level <= query.depth() ? Optional.of(new Entry(number, heading.group(1) + " " + heading.group(2))) : Optional.empty();
            }
            if (!query.list())
                return Optional.empty();
            var item = ITEM.matcher(line);
            if (!item.matches())
                return Optional.empty();
            return title(item.group(2)).map(title -> new Entry(number, item.group(1) + " " + title));
        }

        static Optional<String> title(String text) {
            var bold = BOLD.matcher(text);
            if (bold.find())
                return Optional.of(bold.group(1) != null ? bold.group(1) : bold.group(2));
            var link = LINK.matcher(text);
            if (link.find())
                return Optional.of(link.group(1));
            return Optional.empty();
        }
    }

    /// fenced code blocks are skipped; a fence opened with ``` or ~~~ closes with the same marker
    enum Fence {
        NONE, BACKTICKS, TILDES;

        static final Pattern OPEN = Pattern.compile("^ {0,3}(```+|~~~+).*$");

        Fence next(String line) {
            var matcher = OPEN.matcher(line);
            if (!matcher.matches())
                return this;
            var marker = matcher.group(1).startsWith("`") ? BACKTICKS : TILDES;
            if (this == NONE)
                return marker;
            return this == marker ? NONE : this;
        }

        boolean closed(String line) {
            return this == NONE && OPEN.matcher(line).matches();
        }
    }

    // Scope is shared verbatim by files, search and show — change them together

    record Scope(Path root, boolean all) {

        static final Set<String> IGNORED_ANYWHERE = Set.of("node_modules", "bower_components", "target", "dist",
                "coverage", ".next", ".nuxt", ".svelte-kit", ".cache", ".parcel-cache", ".turbo", ".gradle",
                "__pycache__", ".venv", "venv", ".idea");
        static final Set<String> IGNORED_AT_ROOT = Set.of("build", "out");
        static final List<PathMatcher> DENIED = Stream.of(".env", ".env.*", "*.pem", "*.key", "*.p12", "*.pfx",
                        "*.jks", "*.keystore", "*.kdbx", "id_rsa*", "id_dsa*", "id_ecdsa*", "id_ed25519*", ".npmrc",
                        ".yarnrc.yml", ".netrc", ".pgpass", ".git-credentials", "credentials", "credentials.json",
                        "secrets.{yml,yaml,json,properties}")
                .map(glob -> FileSystems.getDefault().getPathMatcher("glob:" + glob))
                .toList();
        static final List<String> HARMLESS_SUFFIXES = List.of(".example", ".sample", ".template");
        static final long SIZE_LIMIT = 1L << 20;
        static final long SIZE_LIMIT_ALL = 32L << 20;

        boolean ignored(Path directory) {
            var name = directory.getFileName().toString();
            if (name.equals(".git"))
                return true;
            if (all)
                return false;
            return IGNORED_ANYWHERE.contains(name) || (IGNORED_AT_ROOT.contains(name) && root.equals(directory.getParent()));
        }

        boolean denied(Path file) {
            if (relative(file).startsWith(".git/") || relative(file).contains("/.git/"))
                return true;
            var name = file.getFileName();
            if (HARMLESS_SUFFIXES.stream().anyMatch(name.toString()::endsWith))
                return false;
            return DENIED.stream().anyMatch(matcher -> matcher.matches(name));
        }

        boolean contains(Path path) {
            try {
                return path.toRealPath().startsWith(root);
            } catch (IOException e) {
                return false;
            }
        }

        long sizeLimit() {
            return all ? SIZE_LIMIT_ALL : SIZE_LIMIT;
        }

        String relative(Path path) {
            var relative = root.relativize(path).toString().replace(File.separatorChar, '/');
            return relative.isEmpty() ? "." : relative;
        }

        static boolean binary(byte[] head) {
            for (int i = 0; i < Math.min(head.length, 8192); i++)
                if (head[i] == 0)
                    return true;
            return false;
        }
    }
}

// Trace is shared verbatim by every script in this repository — change all copies together

interface Trace {

    Path FILE = Path.of(System.getProperty("user.home"), "zllm-scripts", "zllm-scripts-invocations.log");
    long STARTED = System.currentTimeMillis();
    AtomicInteger EXIT = new AtomicInteger();
    int ARG_LIMIT = 120;
    int LINE_LIMIT = 600;

    static void invocation(String name, String version, List<String> args) {
        Runtime.getRuntime().addShutdownHook(new Thread(() -> append(name, version, args)));
    }

    static void exit(int code) {
        EXIT.set(code);
        System.exit(code);
    }

    static void append(String name, String version, List<String> args) {
        var line = "%s pid=%d %s %s exit=%d ms=%d cwd=%s args=%s%n".formatted(
                Instant.now(), ProcessHandle.current().pid(), name, version, EXIT.get(),
                System.currentTimeMillis() - STARTED, Path.of("").toAbsolutePath(), quote(args));
        try {
            Files.createDirectories(FILE.getParent());
            Files.writeString(FILE, line, StandardOpenOption.CREATE, StandardOpenOption.APPEND);
        } catch (IOException | RuntimeException e) {
            System.err.println(name + ": invocation not logged to " + FILE + ": " + e.getMessage());
        }
    }

    static String quote(List<String> args) {
        var quoted = args.stream()
                .map(arg -> arg.length() > ARG_LIMIT ? arg.substring(0, ARG_LIMIT) + "..." : arg)
                .map(arg -> arg.replace("\\", "\\\\").replace("\"", "\\\"").replaceAll("\\s", " "))
                .map(arg -> '"' + arg + '"')
                .collect(Collectors.joining(" "));
        return quoted.length() > LINE_LIMIT ? quoted.substring(0, LINE_LIMIT) + "..." : quoted;
    }
}


void main(String... args) {
    Boundary.outline(List.of(args));
}
